pkgname=libjxl11-compat
pkgver=0.11.2
pkgrel=2
pkgdesc='JPEG XL 0.11 runtime ABI compatibility libraries'
arch=(x86_64)
url='https://github.com/libjxl/libjxl'
license=(BSD-3-Clause)
depends=(
  brotli
  glibc
  highway
  libgcc
  libstdc++
)
provides=(
  'libjxl.so=0.11-64'
  'libjxl_cms.so=0.11-64'
  'libjxl_threads.so=0.11-64'
)
options=(!strip !debug)
_archive="libjxl-${pkgver}-${pkgrel}-x86_64.pkg.tar.zst"
source_x86_64=("${_archive}::https://archive.archlinux.org/packages/l/libjxl/${_archive}")
sha256sums_x86_64=('5ec33fea9a792f0b69e8c06a61b63df1a4f1d2ba0b3d272308aedde693af4af4')

package() {
  local lib
  for lib in libjxl libjxl_cms libjxl_threads; do
    install -Dm755 "usr/lib/${lib}.so.${pkgver}" \
      "${pkgdir}/usr/lib/${lib}.so.${pkgver}"
    ln -s "${lib}.so.${pkgver}" \
      "${pkgdir}/usr/lib/${lib}.so.0.11"
  done

  install -Dm644 usr/share/licenses/libjxl/LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 usr/share/licenses/libjxl/PATENTS \
    "${pkgdir}/usr/share/licenses/${pkgname}/PATENTS"
}
