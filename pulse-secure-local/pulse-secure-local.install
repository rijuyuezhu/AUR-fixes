# shellcheck shell=bash

all_off="$(tput sgr0 2>/dev/null || true)"
bold="${all_off}$(tput bold 2>/dev/null || true)"
blue="${bold}$(tput setaf 4 2>/dev/null || true)"
yellow="${bold}$(tput setaf 3 2>/dev/null || true)"

note() {
  printf '%s==>%s NOTE:%s %s%s\n' "${blue}" "${yellow}" "${bold}" "$1" "${all_off}"
}

post_install() {
  note "Start the required service with: websudo systemctl enable --now pulsesecure.service"
  note "The legacy WebKitGTK 4.0 runtime uses the genuine libjxl 0.11 ABI from libjxl11-compat."
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl stop pulsesecure.service 2>/dev/null || true
}
